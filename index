// --- Helper Functions ---
const formatCurrency = (amount) => {
  return new Intl.NumberFormat('en-DE', { style: 'currency', currency: 'EUR' }).format(amount);
};

const getDaysUntil23rd = () => {
  const today = new Date();
  const year = today.getFullYear();
  const month = today.getMonth();
  
  let target = new Date(year, month, 23);
  if (today.getDate() > 23) {
    target = new Date(year, month + 1, 23);
  }
  
  const diffTime = Math.abs(target - today);
  return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
};

const getNextDate = (months, day) => {
  const today = new Date();
  const year = today.getFullYear();
  const currentMonth = today.getMonth() + 1; // 1-12
  const currentDay = today.getDate();

  let targetMonth = months.find(m => (m === currentMonth && currentDay <= day) || m > currentMonth);
  let targetYear = year;

  if (!targetMonth) {
    targetMonth = months[0];
    targetYear = year + 1;
  }

  const nextDate = new Date(targetYear, targetMonth - 1, day);
  return nextDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};

